# --- Database (Neon) ---
# Pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string (used by `prisma migrate`)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""           # without @, e.g. shunkhlai_a92_bot
TELEGRAM_WEBHOOK_SECRET=""         # random string, [A-Za-z0-9_-], 1-256 chars: openssl rand -hex 32

# --- Security ---
CRON_SECRET=""                     # openssl rand -hex 32 (Vercel Cron sends it as Bearer token)
SESSION_SECRET=""                  # openssl rand -hex 32 (signs anonymous browser user ids, >=16 chars)
ADMIN_SECRET=""                    # password for /admin (station coordinate editor); empty = admin disabled

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional tuning ---
# FUEL_API_URL="https://shunkhlai-fuel.nasanochir.workers.dev/"
# FUEL_API_TIMEOUT_MS=10000
# POLL_INTERVAL_SECONDS=60          # min gap between syncs; cron may fire more often, extra runs are skipped
# NOTIFICATION_COOLDOWN_MINUTES=30  # anti-flapping: same user+station+type not re-alerted within this window
